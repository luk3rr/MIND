{
  "name": "mind-study",
  "version": "0.1.0",
  "description": "Local-first study tool: generates flashcards and questions with cited sources from your own materials.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && node scripts/check-headers.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "e2e": "electron-vite build && playwright test",
    "db:generate": "drizzle-kit generate --config drizzle.app.config.ts && drizzle-kit generate --config drizzle.workspace.config.ts",
    "package": "umask 022 && electron-vite build && electron-builder --linux deb",
    "package:dir": "umask 022 && electron-vite build && electron-builder --linux --dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "~45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "electron-store": "^12.0.0",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "mupdf": "^1.28.6",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "homepage": "https://github.com/luk3rr/MIND",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luk3rr/MIND.git"
  },
  "author": "Lucas Araújo <araujolucas@dcc.ufmg.br>",
  "desktopName": "mind.desktop"
}
