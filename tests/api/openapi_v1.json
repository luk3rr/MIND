    "/v1/costs": {
      "get": {
        "operationId": "get_costs_v1_costs_get",
        "parameters": [
          {
            "description": "YYYY-MM",
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM",
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostsOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid month."
          }
        },
        "summary": "Spending of a month (defaults to the current one)",
        "tags": [
          "costs"
        ]
      }
    },
