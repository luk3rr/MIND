# Copy to `.env` in the folder where you run `mind`. Every line is optional.

# Where the databases, imported files and the API key are stored.
# Default: your user data directory (for example ~/.local/share/mind on Linux).
# MIND_DATA_DIR=

# The server listens on this interface and port. Keep 127.0.0.1: the API has no authentication.
# MIND_HOST=127.0.0.1
# MIND_PORT=8000

# DEBUG, INFO, WARNING or ERROR.
# MIND_LOG_LEVEL=INFO

# Background jobs that run at the same time (imports, generations).
# MIND_MAX_JOBS=2

# Largest file accepted on upload, in megabytes.
# MIND_MAX_UPLOAD_MB=200

# Tesseract languages used for scanned PDFs (installed ones only), joined with "+".
# MIND_OCR_LANGS=por+eng

# The OpenRouter API key is entered in the app (Settings) and saved in `<data dir>/.env`
# with permission 600. You do not need to put it here.
